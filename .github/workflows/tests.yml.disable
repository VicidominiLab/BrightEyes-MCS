name: Tests

on:
  push:
  pull_request:

jobs:
  windows-tests:
    name: Windows / Python ${{ matrix.python-version }}
    runs-on: windows-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: ["3.10", "3.11", "3.12", "3.13", "3.14"]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          architecture: "x64"
      - name: Install application and test dependencies
        run: python -m pip install -e ".[dev]"
      - name: Run core and Qt-safe tests
        env:
          QT_QPA_PLATFORM: offscreen
        run: python -m pytest -q
      - name: Run Qt isolation tests
        if: matrix.python-version == '3.13'
        env:
          QT_QPA_PLATFORM: offscreen
        run: python -m unittest test.test_channel_delay_skew_plugin -v
      - name: Compile package
        run: python -m compileall -q brighteyes_mcs scripts
